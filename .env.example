# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN - VARIABLES DE ENTORNO
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo y renómbralo a '.env' en la raíz del proyecto:
#    copy .env.example .env
# 2. Reemplaza los valores de ejemplo con tus credenciales reales.
# 3. ¡NUNCA compartas ni subas tu archivo '.env' a GitHub!
# ==============================================================================

# ------------------------------------------------------------------------------
# CREDENCIALES DE SIIGO API
# ------------------------------------------------------------------------------
# Correo o usuario registrado en Siigo API Cloud
SIIGO_USERNAME=tu_usuario_o_correo@ejemplo.com

# Access Key / Token generado desde la plataforma de Siigo
SIIGO_ACCESS_KEY=tu_access_key_aqui

# Nombre identificador del partner/integración
SIIGO_PARTNER_ID=AnalisisFerreteria

# URLs de autenticación y endpoints
SIIGO_AUTH_URL=https://api.siigo.com/auth
SIIGO_API_BASE_URL=https://api.siigo.com/v1

# ------------------------------------------------------------------------------
# CONFIGURACIÓN DE BASE DE DATOS SQL SERVER
# ------------------------------------------------------------------------------
# Driver ODBC instalado en el sistema (ej. ODBC Driver 17 for SQL Server)
DB_DRIVER=ODBC Driver 17 for SQL Server

# Servidor o Instancia SQL Server (ej. localhost, LAPTOP-XYZ\SQLEXPRESS)
DB_SERVER=localhost\SQLEXPRESS

# Nombre de la base de datos
DB_NAME=ferreteria_db

# Tipo de conexión integrada de Windows (yes/no)
DB_TRUSTED_CONNECTION=yes

# Seguridad SSL / Cifrado de conexión
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes

# Opcional: Si no usas autenticación de Windows (Trusted_Connection=no), define usuario y clave:
# DB_USER=sa
# DB_PASSWORD=tu_password_seguro

# ------------------------------------------------------------------------------
# CONFIGURACIÓN DEL SISTEMA DE LOGGING Y EJECUCIÓN
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/etl_ferreteria.log
